+		cx += fw + gap;
+	}
+	// 四邊都要 clamp: 目前 y0 是常數所以 top 不會為負, 但把它留給下一個改動的人踩不划算
+	Common::Rect dirty(x0 - 1, y0 - 1, x0 + totalW + 1, y0 + fh + 1);
+	if (dirty.left < 0) dirty.left = 0;
+	if (dirty.top < 0) dirty.top = 0;
+	if (dirty.right > scr->w) dirty.right = scr->w;
+	if (dirty.bottom > scr->h) dirty.bottom = scr->h;
+	if (dirty.right <= dirty.left || dirty.bottom <= dirty.top)
+		return;
+	updateBackendSurface(&dirty);
+}
+
+
+// 非上游: ScummVM overlay 層 hi-res compositor。每幀把穩定的 320x200 遊戲畫面(indexed)升採 2x
+// 進 640x400 overlay(RGB), 再於其上以 16px Big5 直繪動詞面板中文(升採後行距 17px, 16px 可容納,
+// 清晰不重疊)。遊戲渲染完全不碰 → 繞過 dual-layer 的 layout heisenbug crash。
+// 由 displayScreen 於進遊戲後每幀呼叫; 首次呼叫前需 _system->showOverlay(false)。
+// 非上游: 基準空間(640x400)→ 實際 overlay 空間的填矩形。
+// 用「區間映射」(x0=RX(bx), x1=RX(bx+bw))而非「乘倍率」, 非整數倍(如 aspect 校正的
+// 640x480、retina 的任意物理尺寸)也不會留縫或重疊。
+void AGOSEngine::chtOvlFill(byte *dst, byte *cov, int bx, int by, int bw, int bh, uint32 col) {
+	if (!dst)
+		return;
+	const int ow = _chtOvlW, oh = _chtOvlH, bpp = _chtOvlBpp;
+	int x0 = chtRX(bx), x1 = chtRX(bx + bw);
+	int y0 = chtRY(by), y1 = chtRY(by + bh);
+	if (x1 <= x0) x1 = x0 + 1;      // 縮小映射時至少保留 1px, 不整條消失
+	if (y1 <= y0) y1 = y0 + 1;
+	if (x0 < 0) x0 = 0;
+	if (y0 < 0) y0 = 0;
+	if (x1 > ow) x1 = ow;
+	if (y1 > oh) y1 = oh;
+	for (int yy = y0; yy < y1; yy++) {
+		for (int xx = x0; xx < x1; xx++) {
+			uint idx = (uint)yy * ow + xx;
+			if (bpp == 2) ((uint16 *)dst)[idx] = (uint16)col;
+			else ((uint32 *)dst)[idx] = col;
+			if (cov) cov[idx] = 1;
+		}
+	}
+}
+
+// 非上游: 在基準座標 (bx,by) 畫一個 CJK 點陣字模, 每個字模像素映射成實際 overlay 的
+// 對應矩形 → 字隨 overlay 倍率等比放大(retina 下視覺大小與 x2 一致, 不會縮成一小塊)。
+void AGOSEngine::chtOvlBlitGlyph(byte *dst, byte *cov, const byte *g, int fw, int fh, int bpr, int bx, int by, uint32 col) {
+	if (!dst || !g)
+		return;
+	for (int row = 0; row < fh; row++) {
+		const byte *gr = g + row * bpr;
+		for (int c = 0; c < fw; c++) {
+			if (!(gr[c >> 3] & (0x80 >> (c & 7))))
+				continue;
+			chtOvlFill(dst, cov, bx + c, by + row, 1, 1, col);
+		}
+	}
+}
+
+// 非上游: 字模 + 1 基準像素描邊(描邊位移也在基準空間, 故隨倍率一起放大)。
+void AGOSEngine::chtOvlDrawGlyph(byte *dst, byte *cov, const byte *g, int fw, int fh, int bpr, int bx, int by, uint32 col, uint32 olCol, bool outline) {
+	if (outline) {
+		for (int dy = -1; dy <= 1; dy++)
+			for (int dx = -1; dx <= 1; dx++)
+				if (dx || dy)
+					chtOvlBlitGlyph(dst, cov, g, fw, fh, bpr, bx + dx, by + dy, olCol);
+	}
+	chtOvlBlitGlyph(dst, cov, g, fw, fh, bpr, bx, by, col);
+}
+
+void AGOSEngine::chtOverlayCompose() {
+	if (!_cht.font16)
+		return;
+	Graphics::Surface *game = getBackendSurface();   // 320x200 indexed
+	int gw = game->w, gh = game->h;
+	int ow = _system->getOverlayWidth(), oh = _system->getOverlayHeight();
+	if (ow <= 0 || oh <= 0)
+		return;
+	Graphics::PixelFormat fmt = _system->getOverlayFormat();
+	int bpp = fmt.bytesPerPixel;
+	if (bpp != 2 && bpp != 4)
+		return;
+	// 非上游: overlay 尺寸不是常數 —— retina 高 DPI 回報物理像素、玩家可改 scale factor、
+	// aspect ratio 校正把 400 拉成 480、視窗 resize 也會變。尺寸一變就必須重配 buffer,
+	// 否則後續全部以舊 stride 寫入 → 越界踩記憶體。
+	if (!_chtOvlBuf || ow != _chtOvlW || oh != _chtOvlH || bpp != _chtOvlBpp) {
+		free(_chtOvlBuf);
+		free(_chtTextLayer);
+		free(_chtTextCov);
+		_chtOvlBuf = (byte *)malloc((uint)ow * oh * bpp);
+		_chtTextLayer = (byte *)calloc((uint)ow * oh, bpp);
+		_chtTextCov = (byte *)calloc((uint)ow * oh, 1);
+		_chtOvlW = ow; _chtOvlH = oh; _chtOvlBpp = bpp;
+		debug(1, "CHTOVL: overlay=%dx%d game=%dx%d bpp=%d (基準 640x400 → 映射比 %.2fx/%.2fy)",
+		      ow, oh, gw, gh, bpp, (double)ow / kChtBaseW, (double)oh / kChtBaseH);
+	}
+	if (!_chtOvlBuf || !_chtTextLayer || !_chtTextCov)
+		return;
+	// 預算 palette → overlay 編碼色
+	uint32 palEnc[256];
+	for (int i = 0; i < 256; i++)
+		palEnc[i] = fmt.RGBToColor(_currentPalette[i * 3], _currentPalette[i * 3 + 1], _currentPalette[i * 3 + 2]);
+	// 升採遊戲畫面 (nearest)。
+	// 非上游修正(issue1): 取樣索引必須用比例映射 ox*gw/ow, 不能用整數倍 ox/(ow/gw) ——
+	// overlay 不是遊戲尺寸的整數倍時(retina 物理像素、aspect 校正的 640x480), 整數倍
+	// 除法會讓索引超過 gw-1/gh-1, 讀到 surface 下一列的資料 → 畫面右緣/下緣冒出重複的
+	// 面板影像(玩家 issue1 截圖右側那條重複的 ROOM/INV/WEAPONS)。
+	const byte *src = (const byte *)game->getPixels();
+	uint gpitch = game->pitch;
+	for (int oy = 0; oy < oh; oy++) {
+		int sy = oy * gh / oh;
+		if (sy >= gh) sy = gh - 1;
+		const byte *srow = src + sy * gpitch;
+		byte *drow = _chtOvlBuf + (uint)oy * ow * bpp;
+		if (bpp == 2) {
+			uint16 *d = (uint16 *)drow;
+			for (int ox = 0; ox < ow; ox++)
+				d[ox] = (uint16)palEnc[srow[ox * gw / ow]];
+		} else {
+			uint32 *d = (uint32 *)drow;
+			for (int ox = 0; ox < ow; ox++)
+				d[ox] = palEnc[srow[ox * gw / ow]];
+		}
+	}
+	// getBackendSurface() 非-hires = _system->lockScreen(); 讀完遊戲畫面立即解鎖(下方只寫 _chtOvlBuf)。
+	_system->unlockScreen();
+	// 地圖: 記錄當前房間為已探索; 地圖開啟時疊在遊戲區上。
+	{
+		Item *pl = me();
+		Item *cr = pl ? derefItem(pl->parent) : nullptr;
+		if (cr && isRoom(cr))
+			_chtVisited[(uint16)itemPtrToID(cr)] = 1;
+	}
+	if (_chtMapOn)
+		chtDrawMap();
+	// ── 在 overlay 畫 16px 動詞面板中文 ── (cy = overlay 640x400 座標中心; 英文右對齊至右緣)
+	struct VLabel { int16 cy; byte b[4]; };  // 右欄; 左欄另列
+	// [對齊真值] cy = 該動詞 hitarea 判定框的中心(overlay 座標 = 遊戲座標 x2)。
+	// 判定框由遊戲腳本定義、與面板美術字一一對應, 實測(boxController dump)為:
+	//   右欄 id 0x78..0x81 = (277, 9/17/25/33/41/49/57/65/73/81, 37x7)  → OPEN..THROW
+	//        id 0x82/0x83/0x84 = (277, 99/107/115, 37x7)               → PAUSE/SAVE/RESTORE
+	//   左欄 id 0x73/0x74/0x75 = (6, 12/24/36, 37x7)                   → ROOM/INV/WEAPONS
+	// 中文標籤必須畫在框中心(cy = 2*(boxY+3.5) = 2*boxY+7), 否則「看得到的字」與
+	// 「點得到的框」錯開一格 → 點「開啟」會觸發下一格的 CLOSE。
+	static const VLabel kRight[] = {
+		{ 25, {0xb6,0x7d,0xb1,0xd2}},  // 開啟 OPEN     box 0x78 y9
+		{ 41, {0xc3,0xf6,0xb3,0xac}},  // 關閉 CLOSE    box 0x79 y17
+		{ 57, {0xa4,0x57,0xc2,0xea}},  // 上鎖 LOCK     box 0x7A y25
+		{ 73, {0xb8,0xd1,0xc2,0xea}},  // 解鎖 UNLOCK   box 0x7B y33
+		{ 89, {0xac,0x64,0xac,0xdd}},  // 查看 LOOK IN  box 0x7C y41
+		{105, {0xc0,0xcb,0xb5,0xf8}},  // 檢視 EXAMINE  box 0x7D y49
+		{121, {0xbd,0xd5,0xb0,0x74}},  // 調配 MIX      box 0x7E y57
+		{137, {0xad,0xb9,0xa5,0xce}},  // 食用 CONSUME  box 0x7F y65
+		{153, {0xa8,0xcf,0xa5,0xce}},  // 使用 USE      box 0x80 y73
+		{169, {0xa7,0xeb,0xc2,0x59}},  // 投擲 THROW    box 0x81 y81
+		{205, {0xbc,0xc8,0xb0,0xb1}},  // 暫停 PAUSE    box 0x82 y99
+		{221, {0xa6,0x73,0xc0,0xc9}},  // 存檔 SAVE     box 0x83 y107
+		{237, {0xc5,0xaa,0xc0,0xc9}},  // 讀檔 RESTORE  box 0x84 y115
+	};
+	static const VLabel kLeft[] = {
+		{ 31, {0xa9,0xd0,0xb6,0xa1}},   // 房間 ROOM     box 0x73 y12
+		{ 55, {0xaa,0xab,0xab,0x7e}},   // 物品 INV      box 0x74 y24
+		{ 79, {0xaa,0x5a,0xbe,0xb9}},   // 武器 WEAPONS  box 0x75 y36
+	};
+	// 字型是倚天中文系統(ETEN 3.53)的原生 16x15 點陣 —— 1990 年 DOS 中文的原貌就長這樣,
+	// 比 TTF 縮到這個尺寸更對味(TTF 縮小後筆劃比例不對、複雜字糊成一團)。
+	// 面板用「加粗版」: 倚天 15 點只有偏細明體, 字疊在深色面板上對比不足; 面板字少,
+	// 加粗後厚實好讀且複雜字仍不黏(對白反過來要細版, 見 chtTextLayerPut)。
+	// 面板列距 16px(遊戲 8px), 15px 高的字模剛好留 1px 間隙。
+	const bool bold = (_cht.fontBold != nullptr);
+	const int fw = bold ? _cht.fontWBold : _cht.fontW16;
+	const int fh = bold ? _cht.fontHBold : _cht.fontH16;
+	const int bpr = bold ? _cht.fontBprBold : _cht.fontBpr16;
+	// 非上游: 配色取自原版面板美術(把譯表移開跑英文版, 對面板區取樣直方圖得到)。
+	// 整個面板只有三色: 黑底 #000000、動詞字與花邊 #626141(暗橄欖)、
+	// 系統功能字 #C5C2A4(亮米白)。中文照抄這組語意分色, 面板才與原版美術融合;
+	// 原本一律用 (235,235,210) 白, 比原版亮一階、且失去「動詞 vs 系統功能」的分色。
+	uint32 cVerb   = fmt.RGBToColor(98, 97, 65);      // OPEN..THROW(與花邊同色系)
+	uint32 cBright = fmt.RGBToColor(197, 194, 164);   // PAUSE/SAVE/RESTORE、ROOM/INV/WEAPONS
+	uint32 cBlack = fmt.RGBToColor(0, 0, 0);
+	// 整塊黑底(涵蓋整個文字區, 保證升採後的英文美術字全被蓋掉, 個別 Y 稍偏也不露)。
+	// 上下界貼齊「第一個/最後一個判定框」± 一點餘裕, 不可再往下吃 —— 否則會蓋掉
+	// 狀態列右端的 EXP 數值(overlay y≈254-276)。
+	// 右欄 OPEN..RESTORE: 判定框 y9..121(遊戲) → overlay 18..244, 取 16..246。
+	// 左欄 ROOM/INV/WEAPONS: 判定框 y12..42 → overlay 24..84, 取 22..90。
+	// 黑底只蓋「文字帶」, 不碰兩側的鏈狀花邊 —— 花邊是原版面板美術的一部分,
+	// 蓋掉了中文面板就變成一塊死黑。花邊位置由英文原版逐欄統計非黑像素定出(基準座標):
+	//   右欄 花邊 544..551 / 文字 552..631 / 花邊 632..639
+	//   左欄 花邊 0..8     / 文字 9..87    / 花邊 88..97
+	chtOvlFill(_chtOvlBuf, nullptr, 552, 16, 80, 230, cBlack);   // 右欄 OPEN..RESTORE
+	chtOvlFill(_chtOvlBuf, nullptr, 9, 22, 78, 68, cBlack);      // 左欄 ROOM/INV/WEAPONS
+	int nAll = ARRAYSIZE(kRight) + ARRAYSIZE(kLeft);
+	for (int li = 0; li < nAll; li++) {
+		bool left = (li >= (int)ARRAYSIZE(kRight));
+		const VLabel &L = left ? kLeft[li - (int)ARRAYSIZE(kRight)] : kRight[li];
+		// x 置中於「文字帶」(不含花邊): 右欄 552..631 → 中心 592; 左欄 9..87 → 中心 48。
+		// 2 字寬 = 2*fw, 故起點 = 中心 - fw。
+		int x0 = (left ? 48 : 592) - fw;
+		int y0 = L.cy - fh / 2;
+		// 原版的分色: 動詞(OPEN..THROW)是與花邊同色的暗橄欖, PAUSE/SAVE/RESTORE 與
+		// 左欄 ROOM/INV/WEAPONS 是亮米白。kRight 前 10 項為動詞, 其後 3 項為系統功能。
+		bool bright = left || (li >= 10);
+		uint32 cText = bright ? cBright : cVerb;
+		// 畫 2 個 Big5 字(pass0 描邊 pass1 本體)
+		for (int ci = 0; ci < 2; ci++) {
+			const byte *g = bold ? _cht.glyphBold(L.b[ci * 2], L.b[ci * 2 + 1])
+			                     : _cht.glyph16(L.b[ci * 2], L.b[ci * 2 + 1]);
+			if (!g)
+				continue;
+			int cx = x0 + ci * fw;
+			// 不描邊: 底本來就是純黑, 黑描邊沒有視覺作用, 反而會往外侵蝕一圈花邊。
+			chtOvlDrawGlyph(_chtOvlBuf, nullptr, g, fw, fh, bpr, cx, y0, cText, cBlack, false);
+		}
+	}
+	// 無敵(F7)指示器: 遊戲區頂端疊「無敵模式」(16px, 亮黃 + 描邊 + 深底框, 任意背景皆可見)
+	if (_chtGodMode && _cht.font16) {
+		static const byte kGod[] = {0xb5,0x4c, 0xbc,0xc4, 0xbc,0xd2, 0xa6,0xa1, 0};  // 無敵模式
+		int gx = 210, gy = 6;   // overlay 座標(遊戲區頂端中央偏左)
+		uint32 gcol = fmt.RGBToColor(255, 235, 60), gol = fmt.RGBToColor(0, 0, 0);
+		uint32 gbg = fmt.RGBToColor(20, 20, 20);
+		chtOvlFill(_chtOvlBuf, nullptr, gx - 3, gy - 2, 4 * _cht.fontW16 + 6, _cht.fontH16 + 4, gbg);
+		int cx = gx;
+		for (const byte *s = kGod; *s; s += 2) {
+			const byte *g = _cht.glyph16(s[0], s[1]);
+			if (g)
+				chtOvlDrawGlyph(_chtOvlBuf, nullptr, g, _cht.fontW16, _cht.fontH16, _cht.fontBpr16, cx, gy, gcol, gol, true);
+			cx += _cht.fontW16;
+		}
+	}
+	// 疊上持久 CJK 文字層(對白/敘述, cov==1 處覆蓋)
+	uint npix = (uint)ow * oh;
+	if (bpp == 2) {
+		const uint16 *tl = (const uint16 *)_chtTextLayer;
+		uint16 *ob = (uint16 *)_chtOvlBuf;
+		for (uint i = 0; i < npix; i++)
+			if (_chtTextCov[i]) ob[i] = tl[i];
+	} else {
+		const uint32 *tl = (const uint32 *)_chtTextLayer;
+		uint32 *ob = (uint32 *)_chtOvlBuf;
+		for (uint i = 0; i < npix; i++)
+			if (_chtTextCov[i]) ob[i] = tl[i];
+	}
+	_system->copyRectToOverlay(_chtOvlBuf, ow * bpp, 0, 0, ow, oh);
+}
+
+// 地圖(TAB): 從當前房間 BFS 走已探索的 N/E/S/W 出口鋪 2D 格, 畫進 overlay 遊戲區。
+// 房間框 + 連線 + 當前房間高亮(黃); 探索迷霧: 只顯示 _chtVisited 過的房間。
+void AGOSEngine::chtDrawMap() {
+	if (!_chtOvlBuf)
+		return;
+	Item *player = me();
+	Item *cur = player ? derefItem(player->parent) : nullptr;
+	if (!cur || !isRoom(cur))
+		return;
+	Graphics::PixelFormat fmt = _system->getOverlayFormat();
+	uint32 cBg = fmt.RGBToColor(12, 12, 24), cBorder = fmt.RGBToColor(180, 180, 190);
+	uint32 cRoom = fmt.RGBToColor(90, 90, 110), cCur = fmt.RGBToColor(255, 220, 40);
+	uint32 cLink = fmt.RGBToColor(150, 150, 160), cTxt = fmt.RGBToColor(235, 235, 210);
+	// 非上游: 地圖座標同樣寫在基準 640x400 空間, 逐點經 chtOvlFill 映射到實際 overlay
+	// (高 DPI 下一個基準點 = 一個放大矩形, 線條不會細到看不見)。
+#define CHT_PX(X, Y, C) chtOvlFill(_chtOvlBuf, nullptr, (X), (Y), 1, 1, (C))
+
+	// BFS 已探索房間
+	struct MR { uint16 id; int16 gx, gy; };
+	static MR rooms[256];
+	int nr = 0;
+	Common::HashMap<uint16, int> seen;
+	uint16 curID = (uint16)itemPtrToID(cur);
+	rooms[nr].id = curID; rooms[nr].gx = 0; rooms[nr].gy = 0; seen[curID] = nr; nr++;
+	static const int8 dxx[4] = {0, 1, 0, -1}, dyy[4] = {-1, 0, 1, 0};   // N,E,S,W
+	for (int qi = 0; qi < nr; qi++) {
+		Item *ri = derefItem(rooms[qi].id);
+		if (!ri) continue;
+		for (int d = 0; d < 4; d++) {
+			Item *nb = getExitOf_e1(ri, d);
+			if (!nb || !isRoom(nb)) continue;
+			uint16 nid = (uint16)itemPtrToID(nb);
+			if (nid != curID && !_chtVisited.contains(nid)) continue;   // 迷霧: 只走探索過
+			if (seen.contains(nid)) continue;
+			if (nr >= 256) break;
+			rooms[nr].id = nid;
+			rooms[nr].gx = rooms[qi].gx + dxx[d];
+			rooms[nr].gy = rooms[qi].gy + dyy[d];
+			seen[nid] = nr; nr++;
+		}
+	}
+	// 邊界
+	int minx = 9999, maxx = -9999, miny = 9999, maxy = -9999;
+	for (int i = 0; i < nr; i++) {
+		minx = MIN(minx, (int)rooms[i].gx); maxx = MAX(maxx, (int)rooms[i].gx);
+		miny = MIN(miny, (int)rooms[i].gy); maxy = MAX(maxy, (int)rooms[i].gy);
+	}
+	int cols = maxx - minx + 1, rows = maxy - miny + 1;
+	// 地圖面板(遊戲區中央): overlay x96..544, y28..288
+	int pL = 96, pT = 28, pR = 544, pB = 288;
+	for (int yy = pT; yy < pB; yy++)
+		for (int xx = pL; xx < pR; xx++) CHT_PX(xx, yy, cBg);
+	// 面板邊框
+	for (int xx = pL; xx < pR; xx++) { CHT_PX(xx, pT, cBorder); CHT_PX(xx, pB - 1, cBorder); }
+	for (int yy = pT; yy < pB; yy++) { CHT_PX(pL, yy, cBorder); CHT_PX(pR - 1, yy, cBorder); }
+	// 標題「地圖」(24px, 頂端置中)
+	if (_cht.font) {
+		static const byte kMap[] = {0xa6,0x61, 0xb9,0xcf, 0};   // 地圖
+		int tw = 2 * _cht.fontW, tx = (pL + pR) / 2 - tw / 2, ty = pT + 4;
+		int cxp = tx;
+		for (const byte *s = kMap; *s; s += 2) {
+			const byte *g = _cht.glyph(s[0], s[1]);
+			if (g)
+				chtOvlBlitGlyph(_chtOvlBuf, nullptr, g, _cht.fontW, _cht.fontH, _cht.fontBpr, cxp, ty, cTxt);
+			cxp += _cht.fontW;
+		}
+	}
+	// 格子尺寸(留標題空間 + 邊距)
+	int gridT = pT + 34, gridB = pB - 10, gridL = pL + 12, gridR = pR - 12;
+	int cellW = MIN(56, (gridR - gridL) / MAX(1, cols));
+	int cellH = MIN(40, (gridB - gridT) / MAX(1, rows));
+	if (cellW < 10) cellW = 10;
+	if (cellH < 10) cellH = 10;
+	int roomW = cellW - 8, roomH = cellH - 8;
+	if (roomW < 6) roomW = 6;
+	if (roomH < 6) roomH = 6;
+	// 置中偏移
+	int usedW = cols * cellW, usedH = rows * cellH;
+	int offX = gridL + ((gridR - gridL) - usedW) / 2;
+	int offY = gridT + ((gridB - gridT) - usedH) / 2;
+	// 房間中心座標函式(內嵌)
+	// 先畫連線(相鄰已探索房間之間), 再畫房間框(蓋在連線上)
+	for (int i = 0; i < nr; i++) {
+		int cxi = offX + (rooms[i].gx - minx) * cellW + cellW / 2;
+		int cyi = offY + (rooms[i].gy - miny) * cellH + cellH / 2;
+		Item *ri = derefItem(rooms[i].id);
+		if (!ri) continue;
+		for (int d = 0; d < 4; d++) {
+			Item *nb = getExitOf_e1(ri, d);
+			if (!nb || !isRoom(nb)) continue;
+			uint16 nid = (uint16)itemPtrToID(nb);
+			if (!seen.contains(nid)) continue;
+			int j = seen[nid];
+			int cxj = offX + (rooms[j].gx - minx) * cellW + cellW / 2;
+			int cyj = offY + (rooms[j].gy - miny) * cellH + cellH / 2;
+			// 直線(僅水平/垂直, 因網格對齊)
+			if (cyi == cyj) { int a = MIN(cxi, cxj), b = MAX(cxi, cxj); for (int x = a; x <= b; x++) CHT_PX(x, cyi, cLink); }
+			else if (cxi == cxj) { int a = MIN(cyi, cyj), b = MAX(cyi, cyj); for (int y = a; y <= b; y++) CHT_PX(cxi, y, cLink); }
+		}
+	}
+	for (int i = 0; i < nr; i++) {
+		int rx = offX + (rooms[i].gx - minx) * cellW + (cellW - roomW) / 2;
+		int ry = offY + (rooms[i].gy - miny) * cellH + (cellH - roomH) / 2;
+		bool isCur = (rooms[i].id == curID);
+		uint32 fillc = isCur ? cCur : cRoom;
+		for (int yy = 0; yy < roomH; yy++)
+			for (int xx = 0; xx < roomW; xx++) CHT_PX(rx + xx, ry + yy, fillc);
+		for (int xx = 0; xx < roomW; xx++) { CHT_PX(rx + xx, ry, cBorder); CHT_PX(rx + xx, ry + roomH - 1, cBorder); }
+		for (int yy = 0; yy < roomH; yy++) { CHT_PX(rx, ry + yy, cBorder); CHT_PX(rx + roomW - 1, ry + yy, cBorder); }
+	}
+#undef CHT_PX
+}
+
+// 對白文字層排版常數(overlay 640x400 空間): 小字 14px, 壓縮格 16px 寬 / 18px 行高(比原生 2x=32
+// 緊湊)→ 對白小且貼合對話框、不觸框。引擎換行/捲動仍以原生 16px 格算, 這裡把 (char,line) index
+// 重映射到壓縮格; windowScroll 每 CJK 行呼叫 2 次, 故每次捲動 kChtDlgLineH/2。
+static const int kChtDlgCharW = 16;
+static const int kChtDlgLineH = 18;
+
+// 非上游: 把一串 Big5 直接畫在 overlay 文字層的「原生位置」(overlay = 遊戲座標 x2),
+// 並以 cx 為水平中心。對白走上面的壓縮格(字小、貼合對話框), 但綁 hitarea 的選單
+// (暫停/結束、是/否、覆蓋確認)必須貼齊遊戲腳本定義的判定框 —— 兩者格線不同, 故選單
+// 走這條直繪路徑, 不經 windowPutChar。gcx/gcy = 遊戲座標(320x200)的中心點。
+void AGOSEngine::chtDrawMenuBig5(int gcx, int gcy, const char *s) {
+	if (!_chtTextLayer || !_chtTextCov || !_cht.font16)
+		return;
+	int n = 0;
+	for (const char *p = s; p[0] && p[1]; p += 2)
+		n++;
+	const int fw = _cht.fontW16, fh = _cht.fontH16, bpr = _cht.fontBpr16;
+	Graphics::PixelFormat fmt = _system->getOverlayFormat();
+	uint32 col = fmt.RGBToColor(30, 25, 20);        // 捲軸是米黃底 → 深色字
+	uint32 olc = fmt.RGBToColor(235, 230, 210);     // 淺色描邊, 花紋上也讀得到
+	// x0/y0 仍是基準空間(= 遊戲座標 x2, 對齊腳本定義的判定框), 由 chtOvlDrawGlyph 映射。
+	int x0 = gcx * 2 - n * fw / 2, y0 = gcy * 2 - fh / 2;
+	for (int ci = 0; ci < n; ci++) {
+		const byte *g = _cht.glyph16((byte)s[ci * 2], (byte)s[ci * 2 + 1]);
+		if (!g)
+			continue;
+		chtOvlDrawGlyph(_chtTextLayer, _chtTextCov, g, fw, fh, bpr, x0 + ci * fw, y0, col, olc, true);
+	}
+}
+
+// 非上游: 清掉整層 overlay 文字層(模態選單開/關時用, 避免殘字)。
+void AGOSEngine::chtClearMenuLayer() {
+	if (!_chtTextLayer || !_chtTextCov)
+		return;
+	memset(_chtTextLayer, 0, (size_t)_chtOvlW * _chtOvlH * _chtOvlBpp);
+	memset(_chtTextCov, 0, (size_t)_chtOvlW * _chtOvlH);
+}
+
+// 文字層寫入: 對白/敘述 CJK 改畫進 overlay 持久文字層(倚天 16x15, 壓縮格 16x18), 貼合對話框。
+// x,y = 原生 320x200 像素座標(x=window->x*8+textColumn*8, y=window->y+textRow*8)。
+void AGOSEngine::chtTextLayerPut(WindowBlock *window, uint x, uint y, byte lead, byte trail) {
+	if (!_chtTextLayer || !_chtTextCov)
+		return;
+	const byte *g = _cht.glyph16(lead, trail);
+	if (!g)
+		return;
+	const int fw = _cht.fontW16, fh = _cht.fontH16, bpr = _cht.fontBpr16;
+	Graphics::PixelFormat fmt = _system->getOverlayFormat();
+	byte ti = chtReadableColor((byte)(window->textColor ? window->textColor : 15));
+	uint32 col = fmt.RGBToColor(_currentPalette[ti * 3], _currentPalette[ti * 3 + 1], _currentPalette[ti * 3 + 2]);
+	uint32 olc = fmt.RGBToColor(0, 0, 0);
+	// 由像素座標反推 CJK (char,line) index, 再映射到壓縮格(貼齊視窗左上角 overlay 座標)
+	int charIdx = ((int)x - window->x * 8) / 16;
+	int lineIdx = ((int)y - window->y) / 16;
+	if (charIdx < 0) charIdx = 0;
+	if (lineIdx < 0) lineIdx = 0;
+	int cellX = window->x * 16 + charIdx * kChtDlgCharW;
+	int cellY = window->y * 2 + lineIdx * kChtDlgLineH;
+	int bx = cellX + (kChtDlgCharW - fw) / 2, by = cellY + (kChtDlgLineH - fh) / 2;
+	chtOvlDrawGlyph(_chtTextLayer, _chtTextCov, g, fw, fh, bpr, bx, by, col, olc, true);
+}
+
+// 清除文字層某視窗區(overlay 座標, 鏡像 clearWindow 的 hires 矩形): window->x/width 單位 8px 欄, y/height 像素/8列。
+void AGOSEngine::chtTextLayerClear(WindowBlock *window) {
+	if (!_chtTextCov || !window)
+		return;
+	// 矩形先在基準空間算好, 再映射到實際 overlay(retina / aspect 校正下 stride 不是 640)。
+	int bx = window->x * 16, by = window->y * 2;
+	int hx = chtRX(bx), hy = chtRY(by);
+	int hw = chtRX(bx + window->width * 16) - hx;
+	int hh = chtRY(by + window->height * 16) - hy;
+	if (hx < 0) hx = 0;
+	if (hy < 0) hy = 0;
+	if (hx + hw > _chtOvlW) hw = _chtOvlW - hx;
+	if (hy + hh > _chtOvlH) hh = _chtOvlH - hy;
+	for (int yy = 0; yy < hh; yy++)
+		memset(_chtTextCov + (hy + yy) * _chtOvlW + hx, 0, hw > 0 ? hw : 0);
+}
+
+// 文字層向上捲(壓縮格: 每次 windowScroll 上移 kChtDlgLineH/2; windowPutChar 每 CJK 行呼叫兩次 = 一整行)。
+void AGOSEngine::chtTextLayerScroll(WindowBlock *window) {
+	if (!_chtTextLayer || !_chtTextCov || !window || window->height == 1)
+		return;
+	const int ow = _chtOvlW, bpp = _chtOvlBpp;
+	// 捲動量也是基準空間的 9px, 映射後才是實際 overlay 的位移量(高 DPI 下會 >9px)。
+	const int bShift = kChtDlgLineH / 2;   // 9px 基準; 兩次呼叫 = 一壓縮行
+	int bx = window->x * 16, by = window->y * 2;
+	int hx = chtRX(bx), hy = chtRY(by);
+	int hw = chtRX(bx + window->width * 16) - hx;
+	int shift = chtRY(by + bShift) - hy;
+	if (shift < 1) shift = 1;
+	int ch = (chtRY(by + window->height * 16) - hy) - shift;   // 保留高度(實際 overlay px)
+	if (hx < 0) hx = 0;
+	if (hy < 0) hy = 0;
+	if (hx + hw > ow) hw = ow - hx;
+	if (hw <= 0 || ch <= 0) return;
+	for (int r = 0; r < ch; r++) {
+		int dY = hy + r, sY = hy + r + shift;
+		if (sY >= _chtOvlH) break;
+		memmove(_chtTextLayer + ((uint)dY * ow + hx) * bpp, _chtTextLayer + ((uint)sY * ow + hx) * bpp, (uint)hw * bpp);
+		memmove(_chtTextCov + (uint)dY * ow + hx, _chtTextCov + (uint)sY * ow + hx, hw);
+	}
+	// 底部空出的 shift px 清透明
+	int botY = hy + ch;
+	for (int r = 0; r < shift && botY + r < _chtOvlH; r++)
+		memset(_chtTextCov + (uint)(botY + r) * ow + hx, 0, hw);
+}
